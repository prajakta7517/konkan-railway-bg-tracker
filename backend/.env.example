# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=konkan_railway_bg

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
RESET_TOKEN_EXPIRE_MINUTES=30
COOKIE_SECURE=true
# "lax" works when frontend and backend share the same site; use "none" (requires COOKIE_SECURE=true)
# when the Render static site and web service are on different domains.
COOKIE_SAMESITE=lax

# --- Cloudinary (file storage) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (Gmail SMTP) ---
# Use a Gmail Account App Password, not your normal Gmail password:
# https://myaccount.google.com/apppasswords (requires 2-Step Verification enabled)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Konkan Railway Corporation Limited
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# --- App URLs ---
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- Helpdesk info shown on login page ---
HELPDESK_EMAIL=helpdesk@konkanrailway.gov.in
HELPDESK_PHONE=+91-0000000000

# --- Cron auth (shared secret for the expiry-check script / Render Cron Job) ---
CRON_SECRET=change-this-too

# --- Bootstrap first admin user (used only by scripts/create_admin.py) ---
FIRST_ADMIN_EMAIL=admin@konkanrailway.gov.in
FIRST_ADMIN_PASSWORD=change-me-on-first-login
